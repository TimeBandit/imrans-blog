---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import MainLayout from "../../../layouts/MainLayout.astro";
import PostListPreview from "../../../components/PostListPreview.astro";
import Pagination from "../../../components/Pagination.astro";
import siteConfig from "../../../site.config";
import {
  getAllTags,
  getPostsByTag,
  sortItemsByDateDesc,
} from "../../../utils/helpers";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("blogs"))
    .filter((p) => !p.data.draft)
    .sort(sortItemsByDateDesc);
  const tags = getAllTags(posts);
  return tags.flatMap((tag) => {
    const filtered = getPostsByTag(posts, tag.id);
    return paginate(filtered, {
      params: { id: tag.id },
      pageSize: siteConfig.postsPerPage || 5,
    });
  });
}

type Props = { page: Page<CollectionEntry<"blogs">> };
const { page } = Astro.props;
const { id } = Astro.params;

const allPosts = await getCollection("blogs");
const allTags = getAllTags(allPosts);
const currentTag = allTags.find((t) => t.id === id);
---

<MainLayout
  pageTitle={siteConfig.title + " | " + (currentTag?.name ?? id)}
>
  <div>
    <span aria-hidden="true"></span>
    <div>
      <p>Tag</p>
      <h1>{currentTag?.name ?? id}</h1>
    </div>
    <p>{page.total} post{page.total !== 1 ? "s" : ""}</p>

    <div>
      {page.data.map((post) => <PostListPreview post={post} />)}
    </div>

    {page.lastPage > 1 && <Pagination page={page} />}
  </div>
</MainLayout>
