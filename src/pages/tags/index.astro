---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import { getAllTags, getPostsByTag, sortItemsByDateDesc, withBase } from "../../utils/helpers";

const posts = (await getCollection("blogs"))
  .filter((p) => !p.data.draft)
  .sort(sortItemsByDateDesc);

const tags = getAllTags(posts).sort((a, b) => {
  return getPostsByTag(posts, b.id).length - getPostsByTag(posts, a.id).length;
});
---

<MainLayout
  activePage="tags"
  pageTitle={siteConfig.title + " | Tags"}
>
  <div>
    <span aria-hidden="true"></span>
    <h1>Tags</h1>
    <p>Browse posts by topic.</p>

    <div>
      {
        tags.map((tag) => {
          const count = getPostsByTag(posts, tag.id).length;
          return (
            <ul>
              <li>
                <a href={withBase("/tags/" + tag.id)}>
                  {tag.name}
                  <span>({count})</span>
                </a>
              </li>
            </ul>
          );
        })
      }
    </div>
  </div>
</MainLayout>
