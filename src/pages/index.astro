---
import { getCollection } from "astro:content";
import PostListPreview from "../components/PostListPreview.astro";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { sortItemsByDateDesc, withBase } from "../utils/helpers";

const allPosts = (await getCollection("blogs"))
  .filter((p) => !p.data.draft)
  .sort(sortItemsByDateDesc);

const recentPosts = allPosts.slice(0, siteConfig.recentPostLimit);
---

<MainLayout
  activePage="home"
  pageTitle={siteConfig.title}
>
  <!-- Hero -->
  <section>
    <h1>{siteConfig?.title}</h1>
    <p class="subtitle">{siteConfig?.description}</p>
  </section>

  <!-- Recent posts -->
  <section>
    <h2>Recent writings</h2>
    {recentPosts.map((post) => <PostListPreview post={post} />)}
  </section>
  
  <section>
    <p>
      <a href={withBase("/blog")}>
        View all posts →
      </a>
    </p>
  </section>
</MainLayout>
