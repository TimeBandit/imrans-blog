---
import { Image } from "astro:assets";
import coverImage from "../assets/images/imran-nazir.jpg";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
---

<MainLayout
  activePage="about"
  pageTitle={siteConfig.title + " | About"}
>
  <section>
    <span aria-hidden="true"></span>
    <h1>{siteConfig.about?.title}</h1>
    <p class="subtitle">It's me!</p>
    <Image
      src={coverImage}
      alt="Imran Nazir"
      width={800}
      height={500}
      loading="eager"
    />
    <p>{siteConfig.about?.text}</p>
  </section>
</MainLayout>
