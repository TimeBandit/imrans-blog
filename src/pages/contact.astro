---
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
const contact = siteConfig.contactInfo;
---

<MainLayout
  activePage="contact"
  pageTitle={siteConfig.title + " | Contact"}
>
  <section>
    <span aria-hidden="true"></span>
    <h1>{contact?.title}</h1>
    {contact?.text && <p>{contact.text}</p>}
    {
      contact?.socialProfiles && contact.socialProfiles.length > 0 && (
        <ul>
          {contact.socialProfiles.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                {p.text}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <!-- {
      contact?.email && (
        <div>
        </div>
      )
    } -->

    <!-- {
      contact?.socialProfiles && contact.socialProfiles.length > 0 && (
        <div>
          <span>Social</span>
          <div>
            {contact.socialProfiles.map((p) => (
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                {p.text}
              </a>
            ))}
          </div>
        </div>
      )
    } -->
  </section>
</MainLayout>
