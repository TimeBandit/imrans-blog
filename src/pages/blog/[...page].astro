---
import type { GetStaticPathsOptions, Page } from "astro";
import { type CollectionEntry, getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import PostListPreview from "../../components/PostListPreview.astro";
import Pagination from "../../components/Pagination.astro";
import siteConfig from "../../site.config";
import { sortItemsByDateDesc } from "../../utils/helpers";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("blogs"))
    .filter((p) => !p.data.draft)
    .sort(sortItemsByDateDesc);
  return paginate(posts, { pageSize: siteConfig.postsPerPage || 5 });
}

type Props = { page: Page<CollectionEntry<"blogs">> };
const { page } = Astro.props;
---

<MainLayout
  activePage="blog"
  pageTitle={siteConfig.title + " | Blog"}
  description={siteConfig.blog?.description}
>
<section>
    <span aria-hidden="true"></span>
    <h1>Blog</h1>
    <p class="subtitle">{siteConfig.blog?.description}</p>
</section>
  
<section>
  {page.data.map((post) => <PostListPreview post={post} />)}
</section>

<section>
  <p>
    {page.lastPage > 1 && <Pagination page={page} />}
  </p>
</section>
</MainLayout>
