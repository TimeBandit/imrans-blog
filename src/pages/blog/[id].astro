---
import { type CollectionEntry, getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import siteConfig from "../../site.config";
import { sortItemsByDateDesc, createSlugFromTitle, withBase } from "../../utils/helpers";

export async function getStaticPaths() {
  const posts = (await getCollection("blogs"))
    .filter((p) => !p.data.draft)
    .sort(sortItemsByDateDesc);
  const count = posts.length;
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: i + 1 < count ? posts[i + 1] : null,
      nextPost: i > 0 ? posts[i - 1] : null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"blogs">;
  prevPost: CollectionEntry<"blogs"> | null;
  nextPost: CollectionEntry<"blogs"> | null;
};

const { post, prevPost, nextPost } = Astro.props;
const { title, pubDate, author, tags = [], image } = post.data;
const { Content } = await render(post);
---

<MainLayout
  activePage="blog"
  pageTitle={siteConfig.title + " | " + title}
  description={post.data.description}
  showSubscribeForm={true}
>
  <section>
    <!-- Header -->
    <!-- <header> -->
      <h1>{title}</h1>
      <p class="subtitle">
        <FormattedDate date={new Date(pubDate)} />
        {author && <span>by {author}</span>}

      </p>
      <!-- {
        tags.length > 0 && (
          <div>
            {tags.map((tag) => (
              <a href={withBase("/tags/" + createSlugFromTitle(tag))}>
                {tag}
              </a>
            ))}
          </div>
        )
      } -->
    <!-- </header> -->

    <!-- Hero image
    {
      image?.url && (
        <img
          src={image.url.src ?? image.url}
          alt={image.alt ?? ""}
        />
      )
    } -->

    <!-- Body -->
    <p>
      <Content />
    </p>
<p>
  {tags.map((tag, index) => (
    <>
      <a href={`/tags/${tag.toLowerCase()}`} class="tag-link">#{tag}</a>
      {index < tags.length - 1 && ', '}
    </>
  ))}
</p>

<p>
    <!-- Post navigation -->
    <nav aria-label="Post navigation">
      {
        prevPost && (
          <a href={withBase("/blog/" + prevPost.id)}>
           <p> ← {prevPost.data.title}</p>
          </a>
        )
      }
      {
        nextPost && (
          <a href={withBase("/blog/" + nextPost.id)}>
            <p>{nextPost.data.title} →</p>
          </a>
        )
      }
    </nav>

    <p>
      <a href={withBase("/blog")}>← Back to all posts</a>
    </p>
</p>
  </section>
</MainLayout>
