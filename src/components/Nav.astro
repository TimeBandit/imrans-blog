---
import siteConfig from "../site.config";
import { withBase } from "../utils/helpers";

const { activePage } = Astro.props;
---

<header>
  <div>
    <a href={withBase("/")}>{siteConfig.title}</a>
    <nav aria-label="Primary navigation">
      <ul role="list">
        {
          siteConfig.headerNavLinks
            ?.filter((l) => l.text.toLowerCase() !== "home")
            .map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={
                    activePage === link.text.toLowerCase() ? "page" : undefined
                  }
                >
                  {link.text}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
  </div>
</header>
