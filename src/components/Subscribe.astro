---
import siteConfig from "../site.config";
const sub = siteConfig.subscribe;
---

{
  sub?.formUrl && (
    <section id="subscribe">
      {sub.title && <h2>{sub.title}</h2>}
      {sub.text && <p>{sub.text}</p>}
      <form action={sub.formUrl} method="post">
        <label for="sub-email">Email address</label>
        <div>
          <input
            type="email"
            id="sub-email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button type="submit">Subscribe</button>
        </div>
      </form>
    </section>
  )
}
