---
import siteConfig from "../site.config";
const year = new Date().getFullYear();
---

<footer>
  <div>
    <nav aria-label="Footer navigation">
      {siteConfig.footerNavLinks?.map((link, index, arr) => (
    <>
      <a href={link.href}>{link.text}</a>
      {index < arr.length - 1 && ', '}
    </>
  ))}
    </nav>
    <p>© {year} {siteConfig.title}</p>
  </div>
</footer>
