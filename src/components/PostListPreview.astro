---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../utils/helpers";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  post: CollectionEntry<"blogs">;
};

const { post } = Astro.props;
const { title, pubDate, description, tags = [] } = post.data;
---

<p>
  <a href={withBase("/blog/" + post.id)}>
    {title}
  </a>
  <label for={post.id} class="margin-toggle">&#8853;</label>
  <input type="checkbox" id={post.id} class="margin-toggle"/>
  <span class="marginnote">
    <FormattedDate date={new Date(pubDate)} />
    <br />
  {tags.map((tag, index) => (
    <>
      <a href={`/tags/${tag.toLowerCase()}`} class="tag-link">{tag}</a>
      {index < tags.length - 1 && ', '}
    </>
  ))}
  </span>
</p>
<style>
  /* Reuse Tufte's margin note styling, just tweak the link */
  .tag-link {
    /* color: #111111; */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    font-style: normal; /* Reset italic from marginnote if needed */
  }
  
  .tag-link:hover {
    text-decoration-color: #555;
  }
</style>
